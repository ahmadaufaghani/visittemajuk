{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{blade.php,css,js,json}\" \"lang/**/*.json\" \".github/**/*.{yml,yaml,md}\" \"docs/**/*.md\" \"*.{json,md}\"",
        "format:check": "prettier --check \"resources/**/*.{blade.php,css,js,json}\" \"lang/**/*.json\" \".github/**/*.{yml,yaml,md}\" \"docs/**/*.md\" \"*.{json,md}\"",
        "lint-staged": "lint-staged",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@prettier/plugin-php": "^0.24.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.1",
        "prettier-plugin-blade": "^3.2.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "lint-staged": {
        "*.php": "./vendor/bin/pint",
        "resources/**/*.{blade.php,css,js,json}": "prettier --write",
        ".github/**/*.{yml,yaml,md}": "prettier --write",
        "docs/**/*.md": "prettier --write",
        "lang/**/*.json": "prettier --write",
        "*.{json,md}": "prettier --write"
    }
}
